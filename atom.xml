  <author><name>kijimaD</name></author>
  <content type="html"><![CDATA[<div id="content" class="content">

 <div id="outline-container-org2fcedf8" class="outline-2">
 <h2 id="org2fcedf8"> <a href="#org2fcedf8">この文書のステータス</a></h2>
